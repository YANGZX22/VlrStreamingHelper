{
  "manifest_version": 3,
  "name": "VlrStreamingHelper",
  "version": "2.0.0",
  "description": "Valorant 直播辅助功能及赛程识别导出",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.haojiao.cc/*",
    "https://haojiao.cc/*",
    "https://*.vlr.gg/*",
    "https://vlr.gg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.haojiao.cc/*",
        "https://haojiao.cc/*",
        "https://*.vlr.gg/*",
        "https://vlr.gg/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.haojiao.cc/*",
        "https://haojiao.cc/*"
      ],
      "css": [
        "schedule.css"
      ],
      "js": [
        "schedule.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VlrStreamingHelper",
    "default_popup": "popup.html"
  }
}
